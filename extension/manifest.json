{
  "manifest_version": 3,
  "name": "Teams Screen Share Fix (Unofficial)",
  "version": "0.2.0",
  "description": "Workarounds and diagnostics for Microsoft Teams screen sharing in Firefox on Linux.",
  "browser_specific_settings": {
    "gecko": {
      "id": "teams-screenshare-fix@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "*://teams.microsoft.com/*",
    "*://teams.cloud.microsoft/*",
    "*://teams.live.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://teams.microsoft.com/*",
        "*://teams.cloud.microsoft/*",
        "*://teams.live.com/*"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN",
      "js": [
        "src/config-defaults.js",
        "src/lib/constraints.js",
        "src/shim.js"
      ]
    },
    {
      "matches": [
        "*://teams.microsoft.com/*",
        "*://teams.cloud.microsoft/*",
        "*://teams.live.com/*"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "js": [
        "src/config-defaults.js",
        "src/config-bridge.js"
      ]
    }
  ],
  "action": {
    "default_title": "Teams Screen Share Fix",
    "default_popup": "popup/popup.html"
  }
}
