def firefox_profiles() -> list[Path]:
    roots = [
        Path.home() / ".mozilla" / "firefox",
        Path.home() / ".var" / "app" / "org.mozilla.firefox" / ".mozilla" / "firefox",
        Path.home() / "snap" / "firefox" / "common" / ".mozilla" / "firefox",
    ]
    profiles: list[Path] = []
    for root in roots:
        if not root.is_dir():
            continue
        for child in root.iterdir():
            if child.is_dir() and (child / "prefs.js").exists():
                profiles.append(child)
    return sorted(profiles, key=lambda path: path.name)


def find_firefox_binary() -> str | None:
    candidates = [
        shutil.which("firefox"),
        "/usr/bin/firefox",
        "/usr/bin/firefox-esr",
        "/usr/lib/firefox-esr/firefox-esr",
        "/usr/lib/firefox/firefox",
        "/opt/firefox/firefox",
        "/app/bin/firefox",
        "/snap/firefox/current/usr/lib/firefox/firefox",
    ]
    for candidate in candidates:
        if candidate and Path(candidate).is_file():
            return candidate

    flatpak = shutil.which("flatpak")
    if flatpak:
        output = cmd_output([flatpak, "list", "--app", "--columns=application"])
        if output and "org.mozilla.firefox" in output:
            return "flatpak:org.mozilla.firefox"

    return None


def firefox_version_info() -> tuple[str | None, str | None]:
    binary = find_firefox_binary()
    if not binary:
        return None, None

    if binary.startswith("flatpak:"):
        app = binary.split(":", 1)[1]
        return binary, cmd_output(["flatpak", "run", app, "--version"])

    return binary, cmd_output([binary, "--version"])


def find_omni_ja() -> Path | None:
    candidates: list[Path] = [
        Path("/usr/lib/firefox-esr/browser/omni.ja"),
        Path("/usr/lib/firefox/browser/omni.ja"),
        Path("/opt/firefox/browser/omni.ja"),
        Path("/app/lib/firefox/browser/omni.ja"),
        Path("/snap/firefox/current/usr/lib/firefox/browser/omni.ja"),
    ]

    binary = find_firefox_binary()
    if binary and not binary.startswith("flatpak:"):
        path = Path(binary).resolve()
        candidates.extend(
            [
                path.parent / "browser" / "omni.ja",
                path.parent.parent / "browser" / "omni.ja",
                path.parent / "omni.ja",
            ]
        )

    flatpak_root = Path("/var/lib/flatpak/app/org.mozilla.firefox")
    if flatpak_root.is_dir():
        candidates.extend(flatpak_root.glob("*/*/files/lib/firefox/browser/omni.ja"))

    user_flatpak_root = Path.home() / ".local" / "share" / "flatpak" / "app" / "org.mozilla.firefox"
    if user_flatpak_root.is_dir():
        candidates.extend(user_flatpak_root.glob("*/*/files/lib/firefox/browser/omni.ja"))

    seen: set[Path] = set()
    for candidate in candidates:
        if candidate in seen:
            continue
        seen.add(candidate)
        if candidate.is_file():
            return candidate
    return None


PREFS_RE = re.compile(r'^user_pref\("([^"]+)",\s*(.*)\);\s*$')


def parse_prefs(path: Path) -> dict[str, object]:
    prefs: dict[str, object] = {}
    for line in read_text(path).splitlines():
        match = PREFS_RE.match(line.strip())
        if not match:
            continue
        key, raw = match.group(1), match.group(2)
        try:
            prefs[key] = json.loads(raw)
        except json.JSONDecodeError:
            prefs[key] = raw
    return prefs


def parse_portal_file(path: Path) -> dict[str, str]:
    data: dict[str, str] = {}
    section = None
    for line in read_text(path).splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("[") and line.endswith("]"):
            section = line[1:-1]
            continue
        if section not in (None, "portal"):
            continue
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        data[key.strip()] = value.strip()
    return data


def package_version(package: str) -> str | None:
    if shutil.which("dpkg-query"):
        output = cmd_output(["dpkg-query", "-W", "-f=${Version}", package])
        if output:
            return output

    if shutil.which("rpm"):
        output = cmd_output(["rpm", "-q", "--qf", "%{VERSION}-%{RELEASE}", package])
        if output and "not installed" not in output.lower():
            return output

    if shutil.which("pacman"):
        output = cmd_output(["pacman", "-Q", package])
        if output:
            return output.split()[-1]

    for candidate in (
        shutil.which(package),
        f"/usr/libexec/{package}",
        f"/usr/lib/{package}",
    ):
        if candidate and Path(candidate).is_file():
            output = cmd_output([candidate, "--version"])
            if output:
                match = re.search(r"(\d+\.\d+(?:\.\d+)?)", output)
                if match:
                    return match.group(1)

    return None


def version_tuple(version: str | None) -> tuple[int, int, int] | None:
    if not version:
        return None

    value = version.strip()
    if ":" in value:
        value = value.split(":", 1)[1]

    match = re.search(r"(\d+)\.(\d+)(?:\.(\d+))?", value)
    if not match:
        return None

    major, minor, patch = match.groups()
    return int(major), int(minor), int(patch or 0)


