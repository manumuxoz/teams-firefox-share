def run_checks(no_network: bool = False) -> list[Check]:
    profiles = firefox_profiles()
    checks = [
        check_session(),
        check_firefox(),
        check_webcompat(profiles),
        check_prefs(profiles),
        check_openh264(profiles),
        check_portal(),
        check_backend(),
        check_pipewire(),
        check_xdph(),
        check_xdph_config(),
        check_logs(),
        check_gpu(),
    ]
    if not no_network:
        checks.append(check_teams())
    return checks


def counts(checks: Iterable[Check]) -> dict[str, int]:
    result: dict[str, int] = {}
    for check in checks:
        result[check.status] = result.get(check.status, 0) + 1
    return result


def probable_cause(checks: list[Check]) -> str:
    by_id = {check.id: check for check in checks}

    def status(check_id: str) -> str | None:
        check = by_id.get(check_id)
        return check.status if check else None

    # Hard failures first: a WARN about the session must not mask a dead portal.
    if status("session") == "FAIL":
        return (
            "Sesión gráfica incompleta (Modo C). Corrige XDG_SESSION_TYPE/"
            "WAYLAND_DISPLAY antes de probar Teams."
        )

    if status("firefox") == "FAIL":
        return "Firefox no está instalado o no se encuentra (Modo A)."

    if status("openh264") == "FAIL":
        return (
            "Codec/OpenH264 (Modo B). Microsoft documenta que sin OpenH264 "
            "puede fallar el sharing."
        )

    if status("portal") == "FAIL" or status("backend") == "FAIL":
        return (
            "Portal Wayland/PipeWire (Modo C). El problema está por debajo de "
            "JavaScript: revisa portal, backend y PipeWire."
        )

    # Warnings, ordered by impact.
    if status("session") == "WARN":
        return (
            "Sesión gráfica (Modo C): revisa MOZ_ENABLE_WAYLAND y "
            "XDG_SESSION_TYPE antes de culpar a Teams."
        )

    if status("firefox") == "WARN":
        return (
            "Firefox (Modo A): la versión detectada no es la esperada. "
            "Actualiza a 142+ para el shim y a 146+ para la intervención de Mozilla."
        )

    if status("logs") == "WARN":
        return (
            "Portal Wayland/PipeWire (Modo C) con evidencia en los logs: "
            "out-of-buffers en las últimas 24 h."
        )

    if status("xdph") == "WARN":
        return (
            "Portal Wayland (Modo C, sospechoso): XDPH <1.5.0 no incluye el "
            "fix de congelación. Confirma con el test page y prueba force_shm/X11."
        )

    if status("webcompat") in ("FAIL", "WARN") or status("prefs") == "WARN":
        return (
            "Constraints/WebCompat (Modo B). Revisa la intervención 2000906, "
            "las prefs de captura y usa la extensión como refuerzo."
        )

    if status("gpu") == "WARN":
        return (
            "GPU/NVIDIA (Modo C, sospechoso). Prueba force_shm o X11 antes de "
            "culpar a Firefox."
        )

    return (
        "No se detecta un fallo de sistema. Si Teams sigue fallando, revisa "
        "la consola y el informe de la extensión (Modos B/D/E)."
    )


def print_report(checks: list[Check], verbose: bool = False) -> None:
    print(
        f"Teams screen share doctor {DOCTOR_VERSION} — "
        f"{datetime.now().strftime('%Y-%m-%d %H:%M')}"
    )
    print("=" * 68)

    for check in checks:
        print(f"[{check.status:<4}] {check.title}")
        if check.detail:
            wrapped = textwrap.fill(
                check.detail,
                width=66,
                initial_indent="       ",
                subsequent_indent="       ",
            )
            print(wrapped)
        if verbose and check.fix:
            wrapped = textwrap.fill(
                "fix: " + check.fix,
                width=66,
                initial_indent="       ",
                subsequent_indent="       ",
            )
            print(wrapped)

    summary = counts(checks)
    print("-" * 68)
    print(
        "Resumen: "
        + ", ".join(f"{key}={summary.get(key, 0)}" for key in ("PASS", "WARN", "FAIL", "INFO"))
    )
    print()
    print("Diagnóstico probable:")
    print(textwrap.fill(probable_cause(checks), width=68))
    print()
    print("Siguiente paso:")
    print("  1. Si el diagnóstico es Modo C, revisa docs/DIAGNOSIS.md (portal Wayland).")
    print("  2. Si es Modo B, carga la extensión y comparte en una reunión.")
    print("  3. Adjunta la salida de --json si abres un issue.")


# ---------------------------------------------------------------------------
# Opt-in fixes
# ---------------------------------------------------------------------------


def backup_path(path: Path) -> Path:
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S-%f")
    return path.with_name(f"{path.name}.bak.{stamp}")


def detect_newline(text: str) -> str:
    return "\r\n" if "\r\n" in text else "\n"


def insert_into_screencopy_block(text: str, key: str, value: str) -> tuple[str, str]:
    newline = detect_newline(text)
    trailing_newline = text.endswith(newline) if text else False
    body = text[: -len(newline)] if trailing_newline else text
    lines = body.split(newline) if body else []

    starts = [
        index
        for index, line in enumerate(lines)
        if re.match(r"^\s*screencopy\s*\{", line)
    ]

    if len(starts) > 1:
        return text, "error:multiple-blocks"

    if not starts:
        block = f"screencopy {{{newline}    {key} = {value}{newline}}}{newline}"
        if text and not text.endswith(newline):
            block = newline + block
        return (text + block) if text else block, "appended"

    start = starts[0]
    start_line = lines[start]

    if "}" in start_line:
        # Inline block: screencopy { key = value }
        opening = start_line.index("{")
        closing = start_line.rindex("}")
        content = start_line[opening + 1 : closing].strip()
        content_no_comment = content.split("#", 1)[0].strip()
        if re.search(rf"(^|\s){re.escape(key)}\s*=", content_no_comment):
            match = re.search(
                rf"(^|\s){re.escape(key)}\s*=\s*([^ ]+)",
                content_no_comment,
            )
            if match and match.group(2).lower() in ("false", "0", "no", "off"):
                new_content = re.sub(
                    rf"{re.escape(key)}\s*=\s*[^ ]+",
                    f"{key} = {value}",
                    content_no_comment,
                )
                lines[start] = (
                    start_line[: opening + 1]
                    + " "
                    + new_content
                    + " "
                    + start_line[closing:]
                )
                return newline.join(lines) + (newline if trailing_newline else ""), "replaced-inline"
            return text, "already"
        new_content = (content + f" {key} = {value}").strip()
        lines[start] = (
            start_line[: opening + 1]
            + " "
            + new_content
            + " "
            + start_line[closing:]
        )
        return newline.join(lines) + (newline if trailing_newline else ""), "inserted-inline"

    depth = start_line.count("{") - start_line.count("}")
    end = None
    for index in range(start + 1, len(lines)):
        depth += lines[index].count("{") - lines[index].count("}")
        if depth <= 0:
            end = index
            break

    if end is None:
        return text, "error:missing-brace"

    key_re = re.compile(rf"^(\s*){re.escape(key)}\s*=\s*(.*)$")
    for index in range(start + 1, end):
        match = key_re.match(lines[index])
        if not match:
            continue
        current = match.group(2).split("#", 1)[0].strip()
        if current.lower() in ("false", "0", "no", "off"):
            lines[index] = f"{match.group(1)}{key} = {value}"
            return newline.join(lines) + (newline if trailing_newline else ""), "replaced"
        return text, "already"

    indent = "    "
    for index in range(start + 1, end):
        match = re.match(r"^(\s*)\S", lines[index])
        if match:
            indent = match.group(1)
            break

    lines.insert(end, f"{indent}{key} = {value}")
    return newline.join(lines) + (newline if trailing_newline else ""), "inserted"


def apply_xdph_fix(key: str, value: str, dry_run: bool, force: bool) -> None:
    path = Path.home() / ".config" / "hypr" / "xdph.conf"

    print()
    print(f"Fix: {key} = {value}")
    print(f"Archivo: {path}")

    if path.is_symlink():
        print("El archivo es un symlink; no se modifica por seguridad.")
        return

    for parent in path.parents:
        if parent.is_symlink():
            print(f"El directorio {parent} es un symlink; no se modifica por seguridad.")
            return
        if parent == Path.home():
            break

    if path.exists() and not os.access(path, os.R_OK):
        print("El archivo existe pero no es legible; no se modifica.")
        return

    if key == "force_shm" and not force:
        version = package_version("xdg-desktop-portal-hyprland")
        parsed = version_tuple(version)
        if parsed and parsed >= (1, 5, 0):
            print(
                f"XDPH {version} ya incluye el fix; force_shm no es necesario. "
                "Usa --force para aplicarlo igualmente."
            )
            return

    try:
        original = path.read_text(encoding="utf-8", errors="replace") if path.exists() else ""
    except OSError as exc:
        print(f"No se pudo leer {path}: {exc}")
        return

    rendered_value = f'"{value}"' if " " in value else value
    updated, action = insert_into_screencopy_block(original, key, rendered_value)

    if action == "already":
        print("Ya estaba configurado; no se cambia nada.")
        return

    if action.startswith("error"):
        print(f"No se pudo modificar el archivo ({action}); edítalo a mano.")
        return

    if dry_run:
        print("Dry-run; no se escribe nada. Cambio propuesto:")
        print(updated)
        return

    path.parent.mkdir(parents=True, exist_ok=True)

    if path.exists():
        backup = backup_path(path)
        backup.write_text(original, encoding="utf-8")
        print(f"Backup: {backup}")

    temporary = path.with_name(path.name + ".tmp")
    temporary.write_text(updated, encoding="utf-8")

    if path.exists():
        try:
            os.chmod(temporary, path.stat().st_mode)
        except OSError:
            pass

    os.replace(temporary, path)
    print("Escrito. Reinicia el portal para aplicarlo:")
    print("  systemctl --user restart xdg-desktop-portal-hyprland xdg-desktop-portal")


def restart_portal(dry_run: bool) -> None:
    command = [
        "systemctl",
        "--user",
        "restart",
        "xdg-desktop-portal-hyprland",
        "xdg-desktop-portal",
    ]
    print()
    print("Fix: reiniciar portal")
    print("Comando: " + " ".join(command))
    if dry_run:
        print("Dry-run; no se ejecuta.")
        return
    result = run(command, timeout=15)
    if result is None:
        print("No se pudo ejecutar systemctl.")
        return
    if result.returncode == 0:
        print("Portal reiniciado.")
    else:
        print("Error al reiniciar:")
        print((result.stderr or result.stdout or "").strip())


def apply_fix(action: str, dry_run: bool, force: bool) -> None:
    if action == "xdph-force-shm":
        apply_xdph_fix("force_shm", "true", dry_run, force)
    elif action == "xdph-legacy-picker":
        apply_xdph_fix("custom_picker_binary", "hyprland-share-picker", dry_run, force)
    elif action == "restart-portal":
        restart_portal(dry_run)
    elif action == "x11-command":
        print()
        print("Prueba XWayland/X11 con una instancia nueva:")
        print("  MOZ_ENABLE_WAYLAND=0 firefox --new-instance")
        print("Si funciona, el fallo está en la ruta Wayland/PipeWire.")


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Diagnóstico de compartir pantalla de Teams en Firefox/Linux.",
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {DOCTOR_VERSION}")
    parser.add_argument("--json", action="store_true", help="Salida JSON.")
    parser.add_argument("--verbose", action="store_true", help="Incluye fixes sugeridos.")
    parser.add_argument("--no-network", action="store_true", help="No comprobar endpoints de Teams.")
    parser.add_argument("--output", help="Escribir el informe JSON en este archivo.")
    parser.add_argument(
        "--fix",
        choices=[
            "xdph-force-shm",
            "xdph-legacy-picker",
            "restart-portal",
            "x11-command",
        ],
        help="Aplicar un workaround opt-in (con backup cuando aplica).",
    )
    parser.add_argument("--dry-run", action="store_true", help="Mostrar cambios sin aplicarlos.")
    parser.add_argument(
        "--force",
        action="store_true",
        help="Aplicar force_shm incluso si XDPH >= 1.5.0.",
    )
    args = parser.parse_args(argv)

    if args.json and args.fix:
        print("--json no se puede combinar con --fix.", file=sys.stderr)
        return 2

    checks = run_checks(no_network=args.no_network or bool(args.fix))

    payload = {
        "doctor_version": DOCTOR_VERSION,
        "generated_at": datetime.now().isoformat(timespec="seconds"),
        "checks": [asdict(check) for check in checks],
        "summary": counts(checks),
        "probable_cause": probable_cause(checks),
    }

    if args.output:
        Path(args.output).write_text(
            json.dumps(payload, indent=2, ensure_ascii=False) + "\n",
            encoding="utf-8",
        )
        print(f"Informe JSON escrito en {args.output}")

    if args.json:
        print(json.dumps(payload, indent=2, ensure_ascii=False))
    else:
        print_report(checks, verbose=args.verbose)

    if args.fix:
        apply_fix(args.fix, args.dry_run, args.force)

    return 1 if any(check.status == "FAIL" for check in checks) else 0


if __name__ == "__main__":
    sys.exit(main())
