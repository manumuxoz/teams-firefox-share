def check_session() -> Check:
    session = os.environ.get("XDG_SESSION_TYPE", "")
    wayland = os.environ.get("WAYLAND_DISPLAY", "")
    display = os.environ.get("DISPLAY", "")
    moz = os.environ.get("MOZ_ENABLE_WAYLAND", "")

    detail = (
        f"XDG_SESSION_TYPE={session or '?'}, "
        f"WAYLAND_DISPLAY={wayland or '?'}, "
        f"DISPLAY={display or '?'}, "
        f"MOZ_ENABLE_WAYLAND={moz or '?'}"
    )

    if moz == "0":
        return Check(
            "session",
            "Sesión gráfica",
            "WARN",
            detail + " — MOZ_ENABLE_WAYLAND=0 fuerza X11/XWayland; la captura no usará PipeWire.",
            "Quita MOZ_ENABLE_WAYLAND=0 para probar la ruta Wayland.",
        )

    if session == "wayland" and wayland:
        return Check("session", "Sesión Wayland", "PASS", detail)

    if session == "wayland" and not wayland:
        return Check(
            "session",
            "Sesión Wayland",
            "FAIL",
            detail + " — falta WAYLAND_DISPLAY; Firefox no usará PipeWire.",
            "Exporta WAYLAND_DISPLAY o inicia Firefox desde la sesión Wayland.",
        )

    if wayland and not session:
        return Check(
            "session",
            "Sesión gráfica",
            "WARN",
            detail + " — WAYLAND_DISPLAY presente pero XDG_SESSION_TYPE no está definido.",
            "Exporta XDG_SESSION_TYPE=wayland en el entorno de la sesión.",
        )

    if session == "x11" or (display and not wayland):
        return Check(
            "session",
            "Sesión X11/XWayland",
            "INFO",
            detail + " — la captura usará X11; no requiere portal ScreenCast.",
        )

    return Check(
        "session",
        "Sesión gráfica",
        "WARN",
        detail + " — no se pudo determinar la sesión.",
    )


def check_firefox() -> Check:
    binary, version = firefox_version_info()
    if not binary:
        return Check(
            "firefox",
            "Firefox",
            "FAIL",
            "No se encontró Firefox (PATH, Flatpak ni Snap).",
            "Instala Firefox o ejecuta el doctor con el PATH correcto.",
        )

    if not version:
        return Check(
            "firefox",
            "Firefox",
            "WARN",
            f"Encontrado {binary}, pero no se pudo obtener la versión.",
        )

    parsed = version_tuple(version)
    if parsed and parsed < (128, 0, 0):
        return Check(
            "firefox",
            "Firefox",
            "WARN",
            f"{version} ({binary}); world:MAIN requiere Firefox 128+.",
            "Actualiza a Firefox 128 o superior.",
        )

    return Check("firefox", "Firefox", "PASS", f"{version} ({binary})")


def check_webcompat(profiles: list[Path] | None = None) -> Check:
    if profiles:
        for profile in profiles:
            prefs = parse_prefs(profile / "prefs.js")
            if prefs.get("extensions.webcompat.perform_injections", True) is False:
                return Check(
                    "webcompat",
                    "WebCompat 2000906",
                    "WARN",
                    f"La intervención existe, pero perform_injections=false en {profile.name}.",
                    "Activa extensions.webcompat.perform_injections o usa la extensión.",
                )

    omni = find_omni_ja()
    if not omni:
        return Check(
            "webcompat",
            "WebCompat 2000906",
            "WARN",
            "No se encontró browser/omni.ja; no se pudo verificar la intervención.",
            "Comprueba about:compat en Firefox y busca teams.microsoft.com.",
        )

    try:
        with zipfile.ZipFile(omni) as archive:
            try:
                raw = archive.read(WEBCOMPAT_FILE)
            except KeyError:
                return Check(
                    "webcompat",
                    "WebCompat 2000906",
                    "WARN",
                    f"{omni} no contiene la intervención 2000906.",
                    "Actualiza Firefox; la intervención llegó en 146 y se amplió en 153.",
                )
            data = json.loads(raw)
    except (OSError, zipfile.BadZipFile, json.JSONDecodeError) as exc:
        return Check(
            "webcompat",
            "WebCompat 2000906",
            "WARN",
            f"No se pudo leer {omni}: {exc}",
        )

    matches = (
        data.get("bugs", {})
        .get("2000906", {})
        .get("matches", [])
    )
    missing = [pattern for pattern in TEAMS_MATCHES if pattern not in matches]

    if missing:
        return Check(
            "webcompat",
            "WebCompat 2000906",
            "WARN",
            f"Intervención presente, pero faltan dominios: {', '.join(missing)}.",
            "Actualiza Firefox o usa la extensión para cubrir el dominio que falta.",
        )

    return Check(
        "webcompat",
        "WebCompat 2000906",
        "PASS",
        f"Activa en {omni}; cubre los tres dominios de Teams.",
    )


def check_prefs(profiles: list[Path]) -> Check:
    if not profiles:
        return Check(
            "prefs",
            "Preferencias de Firefox",
            "WARN",
            "No se encontraron perfiles de Firefox.",
        )

    rows: list[str] = []
    issues: list[str] = []

    for profile in profiles:
        prefs = parse_prefs(profile / "prefs.js")
        pipewire = prefs.get("media.webrtc.capture.allow-pipewire", True)
        resize = prefs.get("media.navigator.video.resize_mode.enabled", True)
        webcompat = prefs.get("extensions.webcompat.perform_injections", True)
        openh264 = prefs.get("media.gmp-gmpopenh264.enabled", True)

        if pipewire is False:
            issues.append(f"{profile.name}: pipewire=false")
        if resize is False:
            issues.append(f"{profile.name}: resizeMode=false")
        if webcompat is False:
            issues.append(f"{profile.name}: webcompat=false")
        if openh264 is False:
            issues.append(f"{profile.name}: openh264=false")

        rows.append(
            f"{profile.name}: pipewire={pipewire}, "
            f"resizeMode={resize}, webcompat={webcompat}, openh264={openh264}"
        )

    detail = "; ".join(rows)

    if issues:
        return Check(
            "prefs",
            "Preferencias de Firefox",
            "WARN",
            detail + " — valores problemáticos: " + ", ".join(issues),
            "Revisa las prefs afectadas; la extensión no necesita desactivar resizeMode globalmente.",
        )

    return Check("prefs", "Preferencias de Firefox", "PASS", detail)


def check_openh264(profiles: list[Path]) -> Check:
    if not profiles:
        return Check(
            "openh264",
            "OpenH264",
            "WARN",
            "No se encontraron perfiles de Firefox.",
        )

    found: set[str] = set()
    disabled: set[str] = set()

    for profile in profiles:
        prefs = parse_prefs(profile / "prefs.js")
        enabled = prefs.get("media.gmp-gmpopenh264.enabled", True)
        libraries = list(profile.glob("gmp-gmpopenh264/*/libgmpopenh264.so"))
        for lib in libraries:
            found.add(f"{profile.name}:{lib.parent.name}")
        if libraries and enabled is False:
            disabled.add(profile.name)

    if not found:
        return Check(
            "openh264",
            "OpenH264",
            "FAIL",
            "No se encontró libgmpopenh264.so en ningún perfil.",
            "Abre about:plugins en Firefox y verifica OpenH264; Microsoft lo requiere para sharing completo.",
        )

    if disabled:
        return Check(
            "openh264",
            "OpenH264",
            "WARN",
            ", ".join(sorted(found))
            + " — deshabilitado en: "
            + ", ".join(sorted(disabled)),
            "Activa media.gmp-gmpopenh264.enabled o revisa about:plugins.",
        )

    return Check("openh264", "OpenH264", "PASS", ", ".join(sorted(found)))


def check_portal() -> Check:
    gdbus = shutil.which("gdbus")
    if not gdbus:
        return Check(
            "portal",
            "Portal ScreenCast",
            "INFO",
            "gdbus no está disponible; no se pudo consultar D-Bus.",
        )

    result = run(
        [
            gdbus,
            "call",
            "--session",
            "--dest",
            "org.freedesktop.portal.Desktop",
            "--object-path",
            "/org/freedesktop/portal/desktop",
            "--method",
            "org.freedesktop.DBus.Properties.Get",
            "org.freedesktop.portal.ScreenCast",
            "version",
        ],
        timeout=5,
    )

    if result is None or result.returncode != 0:
        error = (result.stderr or "").strip() if result else "gdbus no disponible"
        return Check(
            "portal",
            "Portal ScreenCast",
            "FAIL",
            f"No responde org.freedesktop.portal.ScreenCast: {error}",
            "Instala/activa xdg-desktop-portal y un backend ScreenCast.",
        )

    match = re.search(r"uint32\s+(\d+)", result.stdout or "")
    version = match.group(1) if match else "?"

    if version != "?" and int(version) < 4:
        return Check(
            "portal",
            "Portal ScreenCast",
            "WARN",
            f"Versión D-Bus {version}; se recomienda 4 o superior.",
            "Actualiza xdg-desktop-portal.",
        )

    return Check("portal", "Portal ScreenCast", "PASS", f"Versión D-Bus {version}.")


def portal_directories() -> list[Path]:
    directories: list[Path] = []

    data_home = os.environ.get("XDG_DATA_HOME")
    if data_home:
        directories.append(Path(data_home) / "xdg-desktop-portal" / "portals")

    data_dirs = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share")
    for entry in data_dirs.split(":"):
        if entry:
            directories.append(Path(entry) / "xdg-desktop-portal" / "portals")

    directories.append(Path("/usr/share/xdg-desktop-portal/portals"))

    unique: list[Path] = []
    seen: set[Path] = set()
    for directory in directories:
        if directory in seen or not directory.is_dir():
            continue
        seen.add(directory)
        unique.append(directory)
    return unique


def check_backend() -> Check:
    directories = portal_directories()
    if not directories:
        return Check(
            "backend",
            "Backend ScreenCast",
            "WARN",
            "No se encontró ningún directorio xdg-desktop-portal/portals.",
        )

    backends: list[dict[str, str]] = []
    for directory in directories:
        for path in sorted(directory.glob("*.portal")):
            data = parse_portal_file(path)
            interfaces = data.get("Interfaces", "")
            if "org.freedesktop.impl.portal.ScreenCast" in interfaces:
                backends.append(
                    {
                        "file": str(path),
                        "dbus": data.get("DBusName", "?"),
                        "use_in": data.get("UseIn", "?"),
                    }
                )

    if not backends:
        return Check(
            "backend",
            "Backend ScreenCast",
            "FAIL",
            "Ningún archivo .portal implementa ScreenCast.",
            "Instala xdg-desktop-portal-hyprland, -wlr, -gnome o -kde según tu escritorio.",
        )

    desktop = os.environ.get("XDG_CURRENT_DESKTOP", "").lower()
    matching = []
    for backend in backends:
        use_in = backend["use_in"].lower()
        if not desktop or not use_in:
            matching.append(backend)
            continue
        tokens = [token for token in use_in.split(";") if token]
        if any(token in desktop for token in tokens):
            matching.append(backend)

    detail = "; ".join(
        f"{Path(backend['file']).name} ({backend['dbus']}, UseIn={backend['use_in']})"
        for backend in backends
    )

    if not matching:
        return Check(
            "backend",
            "Backend ScreenCast",
            "WARN",
            detail + f" — ninguno coincide con XDG_CURRENT_DESKTOP={desktop!r}.",
            "Revisa /usr/share/xdg-desktop-portal/portals y la configuración de xdg-desktop-portal.",
        )

    return Check("backend", "Backend ScreenCast", "PASS", detail)


def check_pipewire() -> Check:
    if not shutil.which("systemctl"):
        return Check(
            "pipewire",
            "PipeWire/WirePlumber",
            "INFO",
            "systemctl no está disponible; no se pudieron comprobar los servicios.",
        )

    issues: list[str] = []
    for unit in ("pipewire", "wireplumber"):
        result = run(["systemctl", "--user", "is-active", unit])
        state = (result.stdout or "").strip() if result else "desconocido"
        if state != "active":
            issues.append(f"{unit}={state}")

    version = cmd_output(["pipewire", "--version"]) or "versión desconocida"

    if issues:
        return Check(
            "pipewire",
            "PipeWire/WirePlumber",
            "WARN",
            f"{version}; " + ", ".join(issues),
            "systemctl --user start pipewire wireplumber",
        )

    return Check("pipewire", "PipeWire/WirePlumber", "PASS", version)


def check_xdph() -> Check:
    version = package_version("xdg-desktop-portal-hyprland")
    if not version:
        return Check(
            "xdph",
            "xdg-desktop-portal-hyprland",
            "INFO",
            "No instalado o no detectado (puede que uses otro backend).",
        )

    parsed = version_tuple(version)
    if parsed is None:
        return Check("xdph", "xdg-desktop-portal-hyprland", "INFO", version)

    if parsed < (1, 5, 0):
        return Check(
            "xdph",
            "xdg-desktop-portal-hyprland",
            "WARN",
            f"{version}; el fix de congelación por out-of-buffers está en 1.5.0+ (PR #424).",
            "Actualiza a 1.5.0+ o prueba --fix xdph-force-shm como mitigación.",
        )

    return Check("xdph", "xdg-desktop-portal-hyprland", "PASS", version)


def screencopy_values(text: str) -> dict[str, str]:
    values: dict[str, str] = {}
    in_block = False
    depth = 0

    for line in text.splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue

        if not in_block and re.match(r"^screencopy\s*\{", stripped):
            if "}" in stripped:
                content = stripped[stripped.index("{") + 1 : stripped.rindex("}")]
                for part in content.split(";"):
                    part = part.split("#", 1)[0].strip()
                    match = re.match(
                        r"^([A-Za-z0-9_]+)\s*=\s*(.+?)\s*$",
                        part,
                    )
                    if match:
                        values[match.group(1)] = match.group(2)
                break

            in_block = True
            depth = stripped.count("{") - stripped.count("}")
            if depth <= 0:
                break
            continue

        if not in_block:
            continue

        depth_before = depth
        depth += stripped.count("{") - stripped.count("}")

        if depth_before == 1 and depth == 1:
            content = stripped.split("#", 1)[0].strip()
            match = re.match(r"^([A-Za-z0-9_]+)\s*=\s*(.+?)\s*$", content)
            if match:
                values[match.group(1)] = match.group(2)

        if depth <= 0:
            break

    return values


def check_xdph_config() -> Check:
    path = Path.home() / ".config" / "hypr" / "xdph.conf"
    version = package_version("xdg-desktop-portal-hyprland")
    parsed = version_tuple(version)

    if not path.exists():
        if parsed and parsed < (1, 5, 0):
            return Check(
                "xdph-config",
                "Configuración XDPH",
                "WARN",
                f"{path} no existe; XDPH {version} usa DMA-BUF por defecto.",
                "Actualiza a 1.5.0+ o prueba --fix xdph-force-shm.",
            )
        return Check(
            "xdph-config",
            "Configuración XDPH",
            "INFO",
            f"{path} no existe; se usan valores por defecto.",
        )

    values = screencopy_values(read_text(path))
    force_shm = values.get("force_shm", "").lower() in ("true", "1", "yes", "on")
    picker = values.get("custom_picker_binary", "default")

    detail = f"{path}: force_shm={'sí' if force_shm else 'no'}, picker={picker}"

    if parsed and parsed < (1, 5, 0) and not force_shm:
        return Check(
            "xdph-config",
            "Configuración XDPH",
            "WARN",
            detail + f"; XDPH {version} sin force_shm.",
            "Prueba --fix xdph-force-shm o actualiza a 1.5.0+.",
        )

    if parsed and parsed >= (1, 5, 0) and force_shm:
        return Check(
            "xdph-config",
            "Configuración XDPH",
            "INFO",
            detail + "; force_shm puede ser innecesario en 1.5.0+.",
        )

    return Check("xdph-config", "Configuración XDPH", "INFO", detail)


def check_logs() -> Check:
    if not shutil.which("journalctl"):
        return Check("logs", "Logs del portal", "INFO", "journalctl no disponible.")

    result = run(
        [
            "journalctl",
            "--user",
            "-u",
            "xdg-desktop-portal-hyprland",
            "-u",
            "xdg-desktop-portal",
            "--since",
            "-24h",
            "-n",
            "500",
            "--no-pager",
        ],
        timeout=10,
    )

    if result is None or result.returncode != 0:
        return Check("logs", "Logs del portal", "INFO", "No se pudieron leer los logs.")

    output = result.stdout or ""
    if "No entries" in output:
        return Check("logs", "Logs del portal", "INFO", "Sin entradas en las últimas 24 h.")

    lines = output.splitlines()
    hard_lines = [line for line in lines if "out of buffers" in line.lower()]
    soft_patterns = {
        "selection_minus_one": "selection -1",
        "session_destroyed": "session destroyed",
        "dma_buf": "dma-buf",
    }
    soft_counts = {
        key: sum(1 for line in lines if needle in line.lower())
        for key, needle in soft_patterns.items()
    }

    detail = ", ".join(
        [f"out_of_buffers={len(hard_lines)}"] if hard_lines else []
    )
    soft_detail = ", ".join(
        f"{key}={value}" for key, value in soft_counts.items() if value
    )
    if soft_detail:
        detail = f"{detail}, {soft_detail}" if detail else soft_detail

    if hard_lines:
        return Check(
            "logs",
            "Logs del portal",
            "WARN",
            detail + " — errores de captura en las últimas 24 h.",
            "journalctl --user -u xdg-desktop-portal-hyprland -f",
        )

    if any(soft_counts.values()):
        return Check(
            "logs",
            "Logs del portal",
            "INFO",
            detail + " — actividad normal de sesiones; no se detectan errores duros.",
        )

    return Check("logs", "Logs del portal", "PASS", "Sin errores recientes.")


def check_gpu() -> Check:
    if not shutil.which("lspci"):
        return Check("gpu", "GPU", "INFO", "lspci no disponible.")

    output = cmd_output(["lspci"]) or ""
    gpus = [
        line
        for line in output.splitlines()
        if re.search(r"VGA|3D|Display", line, re.I)
    ]

    if not gpus:
        return Check("gpu", "GPU", "INFO", "No se detectaron GPUs.")

    detail = " | ".join(gpus)
    if "NVIDIA" in detail.upper():
        return Check(
            "gpu",
            "GPU",
            "WARN",
            detail + " — NVIDIA + DMA-BUF es un caso propenso a fallos; prueba force_shm.",
            "Prueba --fix xdph-force-shm o usa X11.",
        )

    return Check("gpu", "GPU", "INFO", detail)


def check_teams() -> Check:
    results: list[str] = []
    success = False

    for url in TEAMS_URLS:
        request = Request(url, headers={"User-Agent": FIREFOX_UA})
        try:
            with urlopen(request, timeout=8) as response:
                results.append(f"{url} → HTTP {response.status}")
                success = True
        except HTTPError as exc:
            if exc.code in (401, 403):
                results.append(f"{url} → HTTP {exc.code} (alcanzable; requiere auth)")
                success = True
            else:
                results.append(f"{url} → HTTP {exc.code}")
        except (URLError, TimeoutError, OSError) as exc:
            results.append(f"{url} → {exc}")

    status = "PASS" if success else "WARN"
    return Check("teams", "Endpoints de Teams", status, "; ".join(results))


